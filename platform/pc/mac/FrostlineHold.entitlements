<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The Mac App Store build of package_mac.sh: the sandbox alone. The
     game reads its bundle and writes its record through SDL_GetPrefPath,
     which the sandbox moves into the app's container. The script adds the
     application and team identifiers from the provisioning profile. -->
<plist version="1.0">
<dict>
    <key>com.apple.security.app-sandbox</key>
    <true/>
</dict>
</plist>
